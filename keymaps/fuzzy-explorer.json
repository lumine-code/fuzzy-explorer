{
  // `alt-e` reveals the explorer. Bare alt-<letter> is the tier for revealing a
  // surface, one letter per surface; `alt-p` went to project-list, whose
  // initial it is.
  "lumine-workspace": {
    "alt-e": "fuzzy-explorer:toggle"
  },
  ".fuzzy-explorer lumine-text-editor[mini]": {
    // The ecosystem's pair for handing a path to the system: alt-f12 opens it,
    // ctrl-f12 shows it in the file manager. open-external binds the same two
    // in the tree view, the image editor and the PDF view, so the keys mean
    // one thing everywhere rather than one thing per surface.
    "alt-f12": "fuzzy-explorer:open-external",
    "ctrl-f12": "fuzzy-explorer:show-in-folder",
    "alt-left": "fuzzy-explorer:split-left",
    "alt-right": "fuzzy-explorer:split-right",
    "alt-up": "fuzzy-explorer:split-up",
    "alt-down": "fuzzy-explorer:split-down",
    // `alt-v` and `alt-c` are chord prefixes only. Binding a prefix as a
    // complete keystroke as well makes every press wait out the 1000 ms
    // partial-match timeout before the default variant fires.
    "alt-v alt-r": "fuzzy-explorer:insert-relative-path",
    "alt-v alt-a": "fuzzy-explorer:insert-absolute-path",
    "alt-v alt-n": "fuzzy-explorer:insert-file-name",
    "alt-c alt-r": "fuzzy-explorer:copy-relative-path",
    "alt-c alt-a": "fuzzy-explorer:copy-absolute-path",
    "alt-c alt-n": "fuzzy-explorer:copy-file-name",
    "alt-0": "fuzzy-explorer:use-default-separator",
    "alt-/": "fuzzy-explorer:use-forward-slashes",
    "alt-\\": "fuzzy-explorer:use-backslashes",
    "alt-q": "fuzzy-explorer:query-selected-path",
    "alt-s": "fuzzy-explorer:query-selection",
    "f5": "fuzzy-explorer:refresh-index"
  }
}
