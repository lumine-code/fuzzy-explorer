{
  "name": "fuzzy-explorer",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Fuzzy search files across user-defined directories.",
  "keywords": [
    "finder",
    "search",
    "directory",
    "navigation",
    "quick-open"
  ],
  "repository": "https://github.com/lumine-code/fuzzy-explorer",
  "bugs": {
    "url": "https://github.com/lumine-code/fuzzy-explorer/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "specPackages": [
    "launcher"
  ],
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "recentCount": {
      "title": "Number of Recent Entries",
      "description": "How many recently used entries to keep at the top of the list.",
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "ignoredNames": {
      "title": "Ignored Names",
      "description": "Additional glob patterns excluded from this explorer on top of the editor's Ignored Names.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "separator": {
      "title": "Type of separator in file paths",
      "description": "Type of separator for the file path when copying or pasting.",
      "type": "integer",
      "enum": [
        {
          "value": 0,
          "description": "Default"
        },
        {
          "value": 1,
          "description": "Forward Slash"
        },
        {
          "value": 2,
          "description": "Backslash"
        }
      ],
      "default": 0
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "native-clip": {
      "versions": {
        "^1.0.0": "consumeNativeClip"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#b0212a0b99cdece50552c5ea8e30919402bb1b3f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#49c48134ee6e25f8fa2391b41d2151c8f24e3ca2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
