{
  "name": "fuzzy-explorer",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Fuzzy search files across user-defined directories.",
  "keywords": [
    "finder",
    "search",
    "directory",
    "navigation",
    "quick-open"
  ],
  "repository": "https://github.com/lumine-code/fuzzy-explorer",
  "bugs": {
    "url": "https://github.com/lumine-code/fuzzy-explorer/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "recentCount": {
      "title": "Number of Recent Entries",
      "description": "How many recently used entries to keep at the top of the list.",
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "ignoredNames": {
      "title": "Ignored Names",
      "description": "Additional glob patterns excluded from this explorer on top of the editor's Ignored Names.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "separator": {
      "title": "Type of separator in file paths",
      "description": "Type of separator for the file path when copying or pasting.",
      "type": "integer",
      "enum": [
        {
          "value": 0,
          "description": "Default"
        },
        {
          "value": 1,
          "description": "Forward Slash"
        },
        {
          "value": 2,
          "description": "Backslash"
        }
      ],
      "default": 0
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    },
    "native-clip": {
      "versions": {
        "^1.0.0": "consumeNativeClip"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#14913f7d0c2cbc304fbcaf98a9ea0299c2b5166a"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#f81b8d8cef089b525881432dd42efaf16b919bcb",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
